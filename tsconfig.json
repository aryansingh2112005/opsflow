{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "es2020",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node","jest"]
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"],
  "include": ["src"]
}